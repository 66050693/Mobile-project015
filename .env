# Google Gemini (ไม่ใส่ก็ได้ ระบบจะใช้คำอธิบายจากสูตรแทน)
GEMINI_API_KEY=ใส่_GEMINI_API_KEY_ของคุณ
GEMINI_MODEL=gemini-3.6-flash

# YouTube Data API v3 (ไม่ใส่ก็ได้ จะได้ปุ่มค้นหารีวิวบน YouTube แทน)
# YOUTUBE_API_KEY=ใส่_YOUTUBE_API_KEY_ของคุณ

# Firebase Web API Key (ระบบล็อกอิน)
FIREBASE_API_KEY=ใส่_FIREBASE_WEB_API_KEY_ของคุณ

# โหมดทดสอบไม่ต้องล็อกอิน (ใช้ในเครื่องเท่านั้น)
# ALLOW_GUEST=1
